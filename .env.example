# Set these in your shell or Docker Compose environment; the Node service does not auto-load .env.
BRIDGE_HOST=127.0.0.1
PORT=8787
# Optional service password. Put the same value in the TV app settings.
BRIDGE_TOKEN=
# Docker Compose: host interface / published port and image version.
# Use the host LAN address for BRIDGE_BIND_IP if you want to bind one interface.
BRIDGE_BIND_IP=0.0.0.0
BRIDGE_PORT=8787
HONGGUOTV_VERSION=0.1.1
